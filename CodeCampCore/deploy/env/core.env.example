# ==============================================================================
# CodeCampCore — Master Academy ERP Production Environment
# Save to: /var/www/codecamp2026/CodeCampCore/.env
# ==============================================================================

DJANGO_SETTINGS_MODULE=core.settings.prod
DEBUG=False
SECRET_KEY=generate-50-character-secret-key-for-core-here

ALLOWED_HOSTS=core.codecamp.com.ng,portal.codecamp.com.ng,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://core.codecamp.com.ng,https://portal.codecamp.com.ng

# PostgreSQL Database
DATABASE_URL=postgres://codecamp_user:YOUR_STRONG_PASSWORD@localhost:5432/codecamp_core_db

# Security & SSL
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Inter-System API Keys
CORE_API_KEY=cc_live_master_m2m_key_2026
ATTENDANCE_API_KEY=cc_live_attendance_kiosk_key_2026
REGISTRATION_API_KEY=cc_live_registration_gateway_key_2026

ATTENDANCE_API_URL=https://attendance.codecamp.com.ng
REGISTRATION_API_URL=https://codecamp.com.ng

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seravisitorapp@gmail.com
EMAIL_HOST_PASSWORD=lstj fvwc wsyq hiki

DJANGO_ENV=development
DEBUG=True
SECRET_KEY=replace-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me@example.com
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=CodeCamp <replace-me@example.com>

# Subsystem Integrations (M2M API Keys & Endpoints)
CORE_API_KEY=replace-with-a-long-random-core-api-key
ATTENDANCE_API_KEY=replace-with-a-long-random-attendance-key
REGISTRATION_API_KEY=replace-with-a-long-random-registration-key

ATTENDANCE_API_URL=http://127.0.0.1:8001
REGISTRATION_API_URL=http://127.0.0.1:8002

# Use DATABASE_URL in production when possible.
DATABASE_URL=postgresql://user:password@host:5432/codecampcore

# Optional fallback if DATABASE_URL is not provided.
DB_NAME=codecampcore
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

COMPETITION_GLOBAL_ACTIVE=True
